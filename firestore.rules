rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Primitives ---
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return true; }
    function isVerified() { return isSignedIn(); }
    function isAdmin() { 
      return request.auth != null && 
             request.auth.token.email == 'm7mdshipl@gmail.com';
    }

    // --- Admin and System ---
    match /admin/{docId} {
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /adminSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system_updates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /global_notifications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /device_notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_policies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications {
      allow read: if true;
    }
    match /notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Devices ---
    function isValidDevice(data) {
      return data.keys().hasAll(['deviceId', 'ip', 'lastSeen', 'isBlocked']) &&
             data.deviceId is string && data.deviceId.size() <= 128 &&
             data.ip is string && data.ip.size() <= 64 &&
             data.lastSeen is string &&
             data.isBlocked is bool;
    }

    match /devices/{deviceId} {
      allow get: if isValidId(deviceId);
      allow list: if isAdmin();
      allow create: if isValidId(deviceId) && isValidDevice(incoming());
      allow update: if isValidId(deviceId) && (isAdmin() || (incoming().diff(existing()).affectedKeys().hasOnly(['lastSeen', 'ip', 'osInfo', 'customerId', 'adminMessage', 'adminMessageTimestamp', 'needsDataCompletion'])));
      allow delete: if isAdmin();
    }

    // --- Licenses & Trials ---
    function isValidLicense(data) {
      return data.keys().hasAll(['type', 'status', 'createdAt']) &&
             data.type is string && data.status in ['pending', 'active', 'blocked', 'expired'] &&
             data.createdAt is string;
    }

    match /licenses/{licenseKey} {
      allow get: if true; // Everyone can check a license key
      allow list: if true;
      allow create: if true;
      allow update: if isValidId(licenseKey) && (
        isAdmin() || 
        (
          existing().status in ['pending', 'active'] && 
          incoming().diff(existing()).affectedKeys().hasOnly(['deviceId', 'deviceIds', 'customerId', 'status', 'activatedAt', 'expiresAt']) &&
          incoming().status == 'active' && incoming().activatedAt != null
        )
      );
      allow delete: if true;
    }

    match /trials/{deviceId} {
      allow get: if isValidId(deviceId);
      allow create: if isValidId(deviceId) && incoming().deviceId == deviceId && incoming().keys().hasAll(['deviceId', 'usedAt', 'expiresAt']);
      allow list, update, delete: if true;
    }

    // --- Financial & Treasury ---
    match /treasuries/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /treasury_transactions/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /financial_settlements/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /installments/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /sales/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /acc_chart/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /acc_expenses/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /acc_assets/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /acc_cost_centers/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /acc_checks/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- HR & Operations ---
    match /hr_personnel/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /hr_attendance/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /hr_payroll/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /hr_contracts/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /hr_requests/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /op_work_orders/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /op_workflow/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /op_reservations/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /op_rentals/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /op_lease_contracts/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /op_time_tracking/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /op_manufacturing/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /hr_performance/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /hr_commissions/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /products/{id} {
      allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    match /purchases/{id} {
      allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    match /sales_returns/{id} {
      allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    match /purchase_returns/{id} {
      allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    match /activity_logs/{id} {
      allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    match /stock_transfers/{id} {
      allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    match /inventory_audits/{id} {
      allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    match /customer_transactions/{id} {
      allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    
    // --- Customers ---
    match /customers/{customerId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();

      match /history/{historyId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create, update: if true;
        allow delete: if isAdmin();
      }
    }

    match /app_suggestions/{docId} {
      allow create: if true; // Feedback can be public
      allow get, list, update, delete: if isAdmin();
    }
    
    match /app_tampering_logs/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /app_support_tickets/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- Affiliates ---
    match /affiliates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /affiliate_referrals/{id} {
      allow read: if isAdmin();
      allow create: if isValidId(id);
      allow update, delete: if isAdmin();
    }
    match /affiliate_payments/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  
    match /promo_codes/{id} {
      allow read: if true; // Codes need to be checkable
      allow write: if isAdmin();
    }

    match /suppliers/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /partners/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /employees/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /manufacturingOrders/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /supplier_transactions/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Global Safety Net (Catch-all) ---
    match /{document=**} {
      allow read, write: if false;
    }
}
}
